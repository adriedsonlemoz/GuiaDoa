# URL da API backend (Render). Substituir pelo URL real após deploy.
VITE_API_URL=https://SEU-SERVICO.onrender.com
# Segurança / rate limit (opcionais)
LOGIN_RATE_LIMIT_MAX=8
AI_RATE_LIMIT_MAX=20
# Por padrão o primeiro admin é criado sem chave. Para exigir proteção extra:
# REQUIRE_SETUP_KEY=true
# SETUP_KEY=gere-uma-chave-longa-e-aleatoria


# Origens adicionais separadas por vírgula (opcional)
# ALLOWED_ORIGINS=https://seu-dominio.com,https://outro-dominio.com

# Health check profundo testa Cloudinary e Groq somente com sessão de administrador.
# GROQ_API_KEY=...
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...

# MongoDB — para compartilhar o MESMO banco do AL Sistemas sem misturar coleções:
# 1) use a mesma MONGO_URI do AL Sistemas
# 2) use o mesmo nome de banco em MONGO_DB_NAME (se a URI já trouxer o banco, este campo é opcional)
# 3) mantenha um prefixo exclusivo para o Guia DOA
MONGO_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/SEU_BANCO
# MONGO_DB_NAME=mesmo_banco_do_al_sistemas
MONGO_COLLECTION_PREFIX=guiadoa_
# Ative apenas uma vez se precisar renomear coleções antigas doa_* para guiadoa_*
# MONGO_MIGRATE_LEGACY_COLLECTIONS=true

# A Beta 2.8 migra automaticamente os seeds atuais e usa MongoDB como fonte única.
# Não é necessário executar importação manual de seeds.

# Recuperação avançada: reexecuta a migração canônica mesmo se esta versão já foi aplicada.
# Use apenas por um deploy e remova/desative em seguida.
# FORCE_DATA_MIGRATION=true
