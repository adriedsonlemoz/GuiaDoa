# GUIA DOA API — exemplo de ambiente
MONGO_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/SEU_BANCO
# Opcional: force explicitamente o mesmo banco usado pelo AL Sistemas
# MONGO_DB_NAME=mesmo_banco_do_al_sistemas
MONGO_COLLECTION_PREFIX=guiadoa_
# Migração única das coleções legadas doa_* -> guiadoa_*
# MONGO_MIGRATE_LEGACY_COLLECTIONS=true

JWT_SECRET=gere-uma-chave-longa-e-aleatoria
# Por padrão o primeiro admin é criado sem chave. Para exigir proteção extra:
# REQUIRE_SETUP_KEY=true
# SETUP_KEY=gere-outra-chave-longa-e-aleatoria
# GROQ_API_KEY=...
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
# ALLOWED_ORIGINS=https://guia-doa.vercel.app

# A Beta 2.8 migra automaticamente os seeds atuais e usa MongoDB como fonte única.
# Não é necessário executar importação manual de seeds.

# Recuperação avançada: reexecuta a migração canônica mesmo se esta versão já foi aplicada.
# Use apenas por um deploy e remova/desative em seguida.
# FORCE_DATA_MIGRATION=true

# Modelo visual usado apenas pelo Alliance Tracker privado (opcional)
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# GROQ_VISION_FALLBACK_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
