{
  "name": "guiadoa-api",
  "version": "1.0.0-beta.2.70",
  "description": "API admin do Guia DOA",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
